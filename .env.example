# referral-trace-station — 全凭据从环境变量读取，禁止硬编码
# 复制为 .env 并填入实际值（.env 已被 .gitignore 排除）

# === HIS REST 拉快照 ===
HIS_BASE_URL=
HIS_TOKEN=

# === 区域平台 drop 入站（备用）===
REFERRAL_BASE_URL=
REFERRAL_TOKEN=

# === ModelGateway（OpenAI-compatible，ai_role=assist 用）===
# 留空 → ModelGateway::is_configured() = false → 自动降级到字段 diff
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=4000

# === 运行参数 ===
RTS_INBOX_DIR=./inbox
RTS_STATE_DIR=./state
RTS_LOGS_DIR=./logs
RTS_DEBOUNCE_MS=100
